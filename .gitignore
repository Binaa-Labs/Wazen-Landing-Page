# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore env secrets while retaining any env template containing "example".
.env*
!.env*example*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# review screenshots (session artifacts, never shipped)
/_preview/

# photo source originals (optimized WebPs in public/photos/ are what ships)
/_photo-originals/

# Windows folder artifacts
desktop.ini
